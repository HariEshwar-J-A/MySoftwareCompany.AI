# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: pre-created Stripe Price IDs per pack (else price_data is used)
# STRIPE_PRICE_FINTECH_STUDIO=price_...

# Site URL for Stripe redirect URLs (defaults to VERCEL_URL or localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MSC1 license issuance (same Ed25519 key as scripts/.marketplace_dev_key.pem locally)
# MSC_LICENSE_PRIVATE_KEY_PATH=../scripts/.marketplace_dev_key.pem
# MSC_LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Lead form forwarding (HubSpot, Plain, etc.)
# LEAD_WEBHOOK_URL=https://...
