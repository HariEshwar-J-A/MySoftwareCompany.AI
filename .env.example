# MySoftwareCompany.AI — repo root. Run `msc init` to create .env from this file.
# Never commit `.env`. After editing keys: `msc init --env-only` syncs MetaGPT config.

# -----------------------------------------------------------------------------
# Repo (optional — use when running `msc` outside the clone directory)
# -----------------------------------------------------------------------------
# MSC_REPO_ROOT=/absolute/path/to/MySoftwareCompany.AI

# -----------------------------------------------------------------------------
# MSC CLI (~/.msc/config.yaml is still used; these override when set)
# -----------------------------------------------------------------------------
MSC_WORKSPACE_ROOT=./workspace
MSC_ORGS_ROOT=./orgs
MSC_AGENCY_AGENTS_ROOT=./vendor/agency-agents
# MSC_METAGPT_CONFIG=~/.metagpt/config2.yaml
MSC_DEFAULT_ORG=startup-mvp
MSC_DEFAULT_BUDGET=15
MSC_DEFAULT_ROUNDS=20
# OpenRouter tier models — all default to Gemini 2.0 Flash (reliable, multi-provider).
# Override specific tiers when you want stronger/cheaper models:
MSC_LLM_TIER_ECONOMY=google/gemini-2.0-flash-001
MSC_LLM_TIER_STANDARD=google/gemini-2.0-flash-001
MSC_LLM_TIER_PREMIUM=google/gemini-2.0-flash-001
# Alternatives: deepseek/deepseek-v4-flash:free | google/gemma-4-31b-it:free | moonshotai/kimi-k2.6
# MSC_LLM_API_TYPE=openrouter

# Console logging (default: WARNING — no INFO on stderr). File logs always INFO unless DEBUG.
# MSC_LOG_LEVEL=INFO
# Use msc --info for INFO on console, msc --verbose for DEBUG, msc --quiet for ERROR only

# Benchmark runner (usually set by `msc benchmark`, not manually)
# MSC_BENCHMARK_ID=todo-cli
# MSC_BENCHMARK_WORKSPACE=./benchmarks/runs/todo-cli/workspace

# -----------------------------------------------------------------------------
# LLM API keys (for `msc run` / benchmarks — also supported in ~/.metagpt/config2.yaml)
# -----------------------------------------------------------------------------
# OpenRouter (recommended for default tier models above)
OPENROUTER_API_KEY=
MSC_LLM_API_TYPE=openrouter

# Optional fallbacks (if not using OpenRouter)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# METAGPT_API_KEY=

# -----------------------------------------------------------------------------
# Website (Next.js — loaded from this same file when running `npm run dev` in website/)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DEMO_VIDEO_URL=
# NEXT_PUBLIC_GITHUB_REPO=https://github.com/mysoftwarecompany/MySoftwareCompany.AI
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MSC1 tokens at checkout (dev: scripts/.marketplace_dev_key.pem)
MSC_LICENSE_PRIVATE_KEY_PATH=./scripts/.marketplace_dev_key.pem
# MSC_LICENSE_PRIVATE_KEY=

# STRIPE_PRICE_FINTECH_STUDIO=price_...
# LEAD_WEBHOOK_URL=
